# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Albert API key — get yours at https://albert.api.etalab.gouv.fr/
ALBERT_API_KEY=your_api_key_here

# Albert API base URL (default shown — only change if using a different endpoint)
ALBERT_API_BASE_URL=https://albert.api.etalab.gouv.fr/v1

# Embedding model used to build and query the vector index
# Must be the same value at build time and query time
EMBEDDING_MODEL=BAAI/bge-m3
